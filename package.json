{
  "name": "jpff-east-filmroom",
  "private": true,
  "description": "Unofficial fan site that arranges the game videos of the J.P.F.F East YouTube channel by season, team and game type",
  "homepage": "https://jpff-east-filmroom.yamat47.me/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamat47/jpff-east-filmroom.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "typecheck": "astro check",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "validate": "node scripts/validate.ts",
    "game-id": "node scripts/new-game-id.ts",
    "sync": "node --env-file-if-exists=.env scripts/sync.ts",
    "check-removed": "node --env-file-if-exists=.env scripts/check-removed.ts",
    "refresh-live": "node --env-file-if-exists=.env scripts/refresh-live.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run validate && pnpm run build"
  },
  "packageManager": "pnpm@11.8.0",
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
