---
import { FilteredGames } from "../components/FilteredGames.tsx";
import Base from "../layouts/Base.astro";
import { teamsWithGames } from "../lib/catalog.ts";
import { summarize } from "../lib/game-summary.ts";
import { catalog } from "../lib/site-data.ts";

const games = catalog.games.map((game) => summarize(catalog, game));
const teams = teamsWithGames(catalog).map(({ team }) => ({ id: team.id, name: team.name }));
---

<Base>
  <div class="page-head">
    <h1 class="page-title">試合</h1>
    <p class="lead">J.P.F.F East の試合動画を探せます。</p>
  </div>
  {/* Every game goes to the browser with the component, which filters them in place. */}
  <FilteredGames
    client:load
    games={games}
    teams={teams}
    filters={["team", "season", "type"]}
    groupBySeason
  />
</Base>
