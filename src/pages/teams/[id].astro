---
import { GameList } from "../../components/GameList.tsx";
import Base from "../../layouts/Base.astro";
import { gamesOfTeam, teamsWithGames } from "../../lib/catalog.ts";
import { summarize } from "../../lib/game-summary.ts";
import type { Team } from "../../lib/schema.ts";
import { groupBySeason } from "../../lib/season-groups.ts";
import { catalog } from "../../lib/site-data.ts";

export function getStaticPaths() {
  return teamsWithGames(catalog).map(({ team }) => ({ params: { id: team.id }, props: { team } }));
}

interface Props {
  team: Team;
}

const { team } = Astro.props;
const games = gamesOfTeam(catalog, team.id);
const seasons = groupBySeason(games);
---

<Base title={team.name} description={`${team.name}の試合動画の一覧です。`}>
  <div class="page-head">
    <h1 class="page-title">{team.name}</h1>
    <p class="meta">{games.length}試合</p>
  </div>
  <div class="groups">
    {seasons.map((group) => (
      <section>
        <div class="group__head">
          <h2 class="section-title">{group.season}シーズン</h2>
        </div>
        <GameList games={group.games.map((game) => summarize(catalog, game))} />
      </section>
    ))}
  </div>
</Base>
