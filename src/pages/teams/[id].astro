---
import { TeamGames } from "../../components/FilteredGames.tsx";
import { TeamLabel } from "../../components/TeamLabel.tsx";
import Base from "../../layouts/Base.astro";
import { gamesOfTeam, type TeamEntry, teamsWithGames } from "../../lib/catalog.ts";
import { summarize } from "../../lib/game-summary.ts";
import { teamSpanLabel } from "../../lib/labels.ts";
import { catalog } from "../../lib/site-data.ts";

export function getStaticPaths() {
  return teamsWithGames(catalog).map((entry) => ({
    params: { id: entry.team.id },
    props: { entry },
  }));
}

interface Props {
  entry: TeamEntry;
}

const { entry } = Astro.props;
const { team } = entry;
const games = gamesOfTeam(catalog, team.id).map((game) => summarize(catalog, game));
---

<Base title={team.name} description={`${team.name}の試合動画の一覧です。`}>
  <div class="page-head">
    <h1 class="page-title"><TeamLabel team={team} size="large" /></h1>
    <p class="meta">{entry.games}試合・{teamSpanLabel(entry)}</p>
  </div>
  {/* The team's games go to the browser with the component, which narrows them by opponent. */}
  <TeamGames client:load teamId={team.id} games={games} />
</Base>
