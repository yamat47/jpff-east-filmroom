---
import { GameList } from "../../components/GameList.tsx";
import Player from "../../components/Player.astro";
import { TeamLabel } from "../../components/TeamLabel.tsx";
import { TeamTimeline } from "../../components/TeamTimeline.tsx";
import Base from "../../layouts/Base.astro";
import { gamesAround, gamesOfTeam, otherMeetings, sameDayGames } from "../../lib/catalog.ts";
import { summarize } from "../../lib/game-summary.ts";
import type { Game } from "../../lib/schema.ts";
import { groupBySeason } from "../../lib/season-groups.ts";
import { catalog } from "../../lib/site-data.ts";

export function getStaticPaths() {
  return catalog.games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
const summary = summarize(catalog, game);
const [first, second] = summary.teams;
const summaries = (games: readonly Game[]) => games.map((other) => summarize(catalog, other));

const meetings = summaries(otherMeetings(catalog, game));
const sameDay = summaries(sameDayGames(catalog, game));
const timelines = summary.teams.map((team) => ({
  team,
  total: gamesOfTeam(catalog, team.id).length,
  seasons: groupBySeason(summaries(gamesAround(catalog, game, team.id))),
}));
---

<Base
  title={`${first.name} vs ${second.name} (${summary.dateLabel})`}
  description={`${summary.dateLabel}の${first.name} vs ${second.name}（${summary.typeLabel}）の試合動画です。`}
>
  <header class="page-head">
    {/* A line breaks between the two teams, and "vs" goes down with the second. */}
    <h1 class="page-title matchup">
      <a href={`/teams/${first.id}/`}><TeamLabel team={first} size="large" /></a>
      <span class="versus">
        <span class="versus__vs">vs</span>
        <a href={`/teams/${second.id}/`}><TeamLabel team={second} size="large" /></a>
      </span>
    </h1>
    <p class="meta">
      <time datetime={game.date}>{summary.dateLabel}</time>・{summary.typeLabel}・<a
        href={`/seasons/${game.season}/`}>{game.season}シーズン</a
      >
    </p>
  </header>

  <div class="with-rail">
    <div class="with-rail__main game-main">
      <div class="players">
        {game.videos.map((video) => (
          <Player video={video} partLabel={game.videos.length > 1 ? `Part ${video.part}` : null} />
        ))}
      </div>

      {meetings.length > 0 && (
        <section>
          <div class="group__head">
            <h2 class="section-title">この対戦のほかの試合</h2>
            <span class="meta">{meetings.length}試合</span>
          </div>
          <GameList games={meetings} view={{ kind: "date" }} />
        </section>
      )}

      {sameDay.length > 0 && (
        <section>
          <div class="group__head">
            <h2 class="section-title">同じ日の試合</h2>
          </div>
          <GameList games={sameDay} view={{ kind: "matchup", date: "none" }} />
        </section>
      )}
    </div>

    <aside class="rail rail--wide timelines">
      {timelines.map(({ team, total, seasons }) => (
        <TeamTimeline team={team} total={total} seasons={seasons} currentId={game.id} />
      ))}
    </aside>
  </div>
</Base>
