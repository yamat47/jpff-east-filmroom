---
import { GameList } from "../../components/GameList.tsx";
import Player from "../../components/Player.astro";
import Base from "../../layouts/Base.astro";
import { relatedGames } from "../../lib/catalog.ts";
import { summarize } from "../../lib/game-summary.ts";
import type { Game } from "../../lib/schema.ts";
import { catalog } from "../../lib/site-data.ts";

export function getStaticPaths() {
  return catalog.games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
const summary = summarize(catalog, game);
const [first, second] = summary.teams;
const related = relatedGames(catalog, game);

// A list with no other game in it is left out, heading and all.
const sections = [
  { heading: `${first.name}の試合`, list: related.teams[0], href: `/teams/${first.id}/` },
  { heading: `${second.name}の試合`, list: related.teams[1], href: `/teams/${second.id}/` },
  { heading: `${game.season}シーズンの試合`, list: related.season, href: `/seasons/${game.season}/` },
].filter(({ list }) => list.total > 0);
---

<Base
  title={`${first.name} vs ${second.name} (${summary.dateLabel})`}
  description={`${summary.dateLabel}の${first.name} vs ${second.name}（${summary.typeLabel}）の試合動画です。`}
>
  <header class="page-head">
    <h1 class="page-title">
      <span class="page-title__team">{first.name}</span>{" "}
      <span class="page-title__team"><span class="page-title__vs">vs</span> {second.name}</span>
    </h1>
    <p class="meta">
      <time datetime={game.date}>{summary.dateLabel}</time>・{summary.typeLabel}・{game.season}シーズン
    </p>
  </header>

  <div class="players">
    {game.videos.map((video) => (
      <Player video={video} partLabel={game.videos.length > 1 ? `Part ${video.part}` : null} />
    ))}
  </div>

  {sections.length > 0 ? (
    <div class="related">
      {sections.map(({ heading, list, href }) => (
        <section>
          <div class="group__head">
            <h2 class="section-title">{heading}</h2>
            {/* The page it leads to lists this game too, hence one more than the others. */}
            <a class="more" href={href}>
              <span class="visually-hidden">{heading}</span>全{list.total + 1}試合
            </a>
          </div>
          <GameList games={list.games.map((other) => summarize(catalog, other))} />
        </section>
      ))}
    </div>
  ) : (
    <div class="empty">
      <p class="empty__hint">このチームとシーズンには、ほかの試合がありません。</p>
      <a class="more" href="/">試合の一覧へ</a>
    </div>
  )}
</Base>
