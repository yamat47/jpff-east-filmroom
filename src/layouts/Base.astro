---
import { shareCards } from "../lib/site-data.ts";
import { PAGES, SITE } from "../site.ts";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  /** The page's own title; the site's name follows it. Omitted on the top page. */
  title?: string;
  description?: string;
  /** `false` for a page that has no address of its own, as the not-found page. */
  canonical?: boolean;
}

const { title, description, canonical = true } = Astro.props;
const fullTitle = title === undefined ? SITE.name : `${title} | ${SITE.name}`;
const pageDescription = description ?? SITE.description;
const path = Astro.url.pathname;
const url = new URL(path, SITE.url);
// The picture of the page stands beside it. Only a page without an address of its own, as the
// not-found page, has none and shows the picture of the site, which is the one of the top
// page. Any other page that the list of pictures does not have stops the build here: it would
// name a picture that was not drawn.
const hasPicture = shareCards.has(path);
if (canonical && !hasPicture) {
  throw new Error(`${path} has no picture for a shared link: add it to src/lib/share-cards.ts`);
}
const picture = {
  url: new URL(`${hasPicture ? path : "/"}${SITE.shareImage.file}`, SITE.url),
  alt: [...(hasPicture && title !== undefined ? [title] : []), SITE.name, SITE.unofficialNote].join(
    "、",
  ),
};
const NAV = [PAGES.games, PAGES.teams, PAGES.seasons];
const ABOUT = PAGES.about;
// "page" on the entry that is this page, "true" on the entry this page belongs under. The top
// page is no entry: the name of the site leads to it.
const currentOf = (href: string) => {
  if (path === href) return "page";
  return path.startsWith(href) ? "true" : undefined;
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonical && <link rel="canonical" href={url} />}
    {/* What a link to the page shows where it is shared: the page's own title and description,
        and the page's own picture. The name of the site is left out of the title: it is in
        og:site_name and on the picture. A service fetches the picture from outside the site,
        so its address is written whole, and its size is given so that the card is laid out
        before the picture has come. */}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={url} />}
    <meta property="og:image" content={picture.url} />
    <meta property="og:image:width" content={String(SITE.shareImage.width)} />
    <meta property="og:image:height" content={String(SITE.shareImage.height)} />
    <meta property="og:image:alt" content={picture.alt} />
    {/* Without this X shows the picture as a small square beside the title. */}
    <meta name="twitter:card" content="summary_large_image" />
    {/* The drawing for a browser that takes one, a picture of it for the others, and a larger
        picture for the home screen of a phone. All three are in public/. The size on the
        picture keeps a browser that takes both from choosing it over the drawing. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* A filter works only with JavaScript; without it the full list stands. */}
    <noscript><style>.filter, .rail--filter { display: none; }</style></noscript>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="site-name" href="/">{SITE.name}</a>
        <nav class="site-nav" aria-label="サイト内">
          <ul>
            {NAV.map(({ href, title }) => (
              <li>
                <a href={href} aria-current={currentOf(href)}>{title}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p>非公式のファンサイトです。動画は J.P.F.F East 公式 YouTube チャンネルのものです。</p>
        <ul class="site-footer__links">
          <li><a href={SITE.channelUrl}>公式 YouTube</a></li>
          <li><a href={SITE.officialSiteUrl}>公式サイト</a></li>
          <li><a href={ABOUT.href} aria-current={currentOf(ABOUT.href)}>{ABOUT.title}</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
